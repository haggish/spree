# Spree Backend Environment Variables

# Server port (default: 3000)
PORT=3000

# Google Maps API key — required for real routing
# Get one at https://console.cloud.google.com/apis/credentials
# Enable: Routes API, Maps JavaScript API, Places API
GOOGLE_MAPS_API_KEY=your-api-key-here

# Keycloak configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=spree

# Database (Postgres)
DATABASE_URL=postgres://spree:spree@localhost:5432/spree
